@startuml component
title Kanban: компонентҳо (MVC, се сатҳ)
skinparam dpi 150

node "Мизоҷ" {
  [Браузер\n(HTML, CSS, JavaScript)] as Browser
}

node "Веб-сервер (Apache дар XAMPP + PHP 8)" {
  package "Сатҳи муаррифӣ" {
    [index.html, style.css, app.js\n(View: шаблон ва рендер)] as View
    [api.php\n(front controller)] as Front
  }
  package "Сатҳи мантиқ" {
    [Router\n(интихоб аз рӯи ?action=)] as Router
    [Controllers\n(Auth, Project, Board, Task,\nComment, Upload)] as Controllers
    [Services\n(Session/Auth, санҷиши нақш,\nнавиштани таърих)] as Services
  }
  package "Сатҳи дастрасӣ ба додаҳо" {
    [Repositories\n(User, Project, Column, Task,\nComment, History)] as Repos
    [Database\n(PDO)] as Db
    [uploads/\n(файлҳои замима)] as Files
  }
}

database "MySQL / MariaDB\nkanban" as MySQL

Browser --> View : HTTP GET (HTML, CSS, JS)
Browser --> Front : HTTP POST api.php?action=... (JSON, fetch)
Front --> Router
Router --> Controllers
Controllers --> Services
Controllers --> Repos
Controllers --> Files : move_uploaded_file
Services --> Repos
Repos --> Db
Db --> MySQL : PDO, TCP 3306

legend right
  Model = Repositories + Database
  View = index.html + style.css + app.js
  Controller = Controllers (тавассути Router)
endlegend
@enduml
