@startuml class
title Kanban: диаграммаи синфҳо
skinparam classAttributeIconSize 0
skinparam dpi 150
hide empty members

package "Модели доменӣ" {
  class User <<entity>> {
    +id: int
    +name: string
    +email: string
    -passwordHash: string
    +createdAt: datetime
  }
  class Project <<entity>> {
    +id: int
    +name: string
    +description: ?string
    +ownerId: int
    +createdAt: datetime
  }
  class ProjectMember <<entity>> {
    +id: int
    +projectId: int
    +userId: int
    +role: MemberRole
  }
  class Column <<entity>> {
    +id: int
    +projectId: int
    +title: string
    +position: int
  }
  class Task <<entity>> {
    +id: int
    +columnId: int
    +title: string
    +description: ?string
    +assigneeId: ?int
    +dueDate: ?date
    +priority: Priority
    +position: int
    +isOverdue(): bool
  }
  class TaskComment <<entity>> {
    +id: int
    +taskId: int
    +body: string
    +createdAt: datetime
  }
  class TaskHistory <<entity>> {
    +id: int
    +taskId: int
    +action: string
    +details: string
    +createdAt: datetime
  }
  class TaskAttachment <<entity>> {
    +id: int
    +originalName: string
    +storedName: string
    +createdAt: datetime
  }
  enum MemberRole {
    manager
    member
  }
  enum Priority {
    low
    medium
    high
  }
}

Project "1" *-- "1..*" Column : дорои сутунҳо
Column "1" o-- "0..*" Task : дорои корт
Task "1" *-- "0..*" TaskComment : шарҳҳо
Task "1" *-- "0..*" TaskHistory : таърих
Task "1" *-- "0..*" TaskAttachment : замимаҳо
Project "1" *-- "1..*" ProjectMember : иштирокчиён
User "1" -- "0..*" ProjectMember : узв аст
Task "0..*" --> "0..1" User : иҷрокунанда
User "1" -- "0..*" TaskComment : менависад >
User "1" -- "0..*" TaskHistory : тағйир медиҳад >
ProjectMember ..> MemberRole
Task ..> Priority

package "Замима (синфҳои код)" {
  class TaskController {
    -repo: TaskRepository
    -auth: Auth
    +create(): void
    +update(id: int): void
    +move(id: int, columnId: int, position: int): void
    +detail(id: int): void
  }
  class TaskRepository {
    -db: Database
    +findById(id: int): ?array
    +findByColumn(columnId: int): array
    +create(data: array): int
    +updateColumn(id: int, columnId: int): bool
    +reorder(columnId: int, ids: array): void
    +addHistory(taskId: int, userId: int, action: string, details: string): void
  }
  class Database {
    -pdo: PDO
    +pdo(): PDO
  }
  class Auth {
    -db: Database
    +userId(): int
    +role(projectId: int): string
  }
}

TaskController --> TaskRepository
TaskController --> Auth
TaskRepository --> Database
Auth --> Database
TaskRepository ..> Task : мехонад/менависад
@enduml
